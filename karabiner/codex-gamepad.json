{
  "title": "Codex Gamepad (DirectInput)",
  "rules": [
    {
      "description": "Codex Gamepad — navigation (8BitDo Ultimate 2C)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "generic_desktop": "dpad_up", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "up_arrow" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "generic_desktop": "dpad_down", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "down_arrow" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "generic_desktop": "dpad_left", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_arrow" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "generic_desktop": "dpad_right", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_arrow" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button1", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "return_or_enter" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button2", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "escape" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button4", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "tab" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button5", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "k", "modifiers": ["left_command"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button7", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "open_bracket", "modifiers": ["left_command", "left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button8", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "close_bracket", "modifiers": ["left_command", "left_shift"] }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        }
      ]
    },
    {
      "description": "Codex Gamepad — Kokoro speak/stop (Karabiner 16 receiver)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button3", "modifiers": { "optional": ["any"] } },
          "to": [{ "send_user_command": { "endpoint": "/tmp/codex-gamepad-user-command.sock", "payload": { "command": "codex_speak_last_response", "version": 1 } } }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button6", "modifiers": { "optional": ["any"] } },
          "to": [{ "send_user_command": { "endpoint": "/tmp/codex-gamepad-user-command.sock", "payload": { "command": "codex_speak_last_response", "version": 1 } } }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        }
      ]
    },
    {
      "description": "Codex Gamepad — Kokoro speak/stop (legacy shell fallback; do not enable with receiver rule)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button3", "modifiers": { "optional": ["any"] } },
          "to": [{ "shell_command": "\"$HOME/.local/bin/codex-speak-last\" --background --toggle --require-frontmost" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        },
        {
          "type": "basic",
          "from": { "pointing_button": "button6", "modifiers": { "optional": ["any"] } },
          "to": [{ "shell_command": "\"$HOME/.local/bin/codex-speak-last\" --background --toggle --require-frontmost" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "is_game_pad": true }] },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.openai\\.codex$"] }
          ]
        }
      ]
    }
  ]
}
